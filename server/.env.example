# Copy to .env. Never commit .env — SR-13 keeps credentials out of the repository.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/peerly_dev
# Comma-separated origins allowed to call the API (CI-06).
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Institutional e-mail domains accepted at registration (IS-01 — confirm with Sponsor).
STUDENT_EMAIL_DOMAINS=mynwu.ac.za
STAFF_EMAIL_DOMAINS=nwu.ac.za
# Session lifetimes in minutes (SR-05).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720
# Token lifetimes in minutes (FR-03 default 24h, FR-06 default 1h).
ACTIVATION_TOKEN_MINUTES=1440
RECOVERY_TOKEN_MINUTES=60
