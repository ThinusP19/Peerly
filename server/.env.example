# Copy to .env and fill in. Never commit .env: SR-13 keeps credentials out of the repository.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Leave unset in development. In production use 127.0.0.1 so only the proxy can reach the API.
HOST=
DATABASE_URL=postgres://localhost:5432/peerly_dev
# Comma-separated origins allowed to call the API (CI-06). The web app runs on port 7331.
CORS_ORIGINS=http://127.0.0.1:7331,http://localhost:7331

# --- Accounts ---------------------------------------------------------------
# Institutional email domains accepted at registration (IS-01: confirm with the Sponsor).
STUDENT_EMAIL_DOMAINS=mynwu.ac.za
STAFF_EMAIL_DOMAINS=nwu.ac.za
# Session lifetimes in minutes (SR-05).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720
# Token lifetimes in minutes (FR-03 default 24h, FR-06 default 1h).
ACTIVATION_TOKEN_MINUTES=1440
RECOVERY_TOKEN_MINUTES=60
# How long the 6-digit registration email code stays valid, in minutes.
EMAIL_CODE_MINUTES=10

# --- Email (CI-05) ----------------------------------------------------------
# Base URL of the web app, used for links inside emails (activation, password reset).
APP_URL=http://127.0.0.1:7331
# "log" prints every email to the server console instead of sending it, so the API
# runs without SMTP credentials. Set to "smtp" once the values below are filled in;
# the server then refuses to start if any required one is missing.
MAIL_TRANSPORT=log
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Peerly
MAIL_FROM_ADDRESS=
# Optional: where replies go, if not the from address.
MAIL_REPLY_TO=

# --- Mailgun -----------------------------------------------------------------
# Two ways to send through Mailgun. Pick one.
#
# 1. The HTTP API (MAIL_TRANSPORT=mailgun) - an API key instead of an SMTP login:
#
#   MAIL_TRANSPORT=mailgun
#   MAILGUN_API_KEY=<a private API key, or a sending key for this domain>
#   MAILGUN_DOMAIN=mg.your-domain.ac.za
#   MAILGUN_REGION=eu                 # or us - must match where the domain was created
#   MAIL_FROM_ADDRESS=peerly@mg.your-domain.ac.za
#
# 2. SMTP (MAIL_TRANSPORT=smtp) - values from Sending > Domain settings > SMTP
#    credentials in the Mailgun dashboard:
#
#   MAIL_TRANSPORT=smtp
#   SMTP_HOST=smtp.mailgun.org        # smtp.eu.mailgun.org for an EU domain
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=postmaster@mg.your-domain.ac.za
#   SMTP_PASSWORD=<the SMTP password, not the API key>
#   MAIL_FROM_ADDRESS=peerly@mg.your-domain.ac.za
#
# Two things that catch people out:
#   - The SMTP password is NOT the API key. They are different credentials.
#   - An API key only works in its own region: an EU domain needs MAILGUN_REGION=eu.
#   - MAIL_FROM_ADDRESS must be on the verified Mailgun domain, or the relay
#     refuses the message.
# Choose the EU region when creating the domain: student data then stays in the
# EU rather than the US, which is the easier position under POPIA.
# See docs/handover/deployment.md.
